{
  "name": "@deepseek-ai/dsh-desktop-extras",
  "description": "Optional bundle carrying the desktop application's third-party plugins, enabled from the Plugins page",
  "version": "0.1.7-rc.2",
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/desktop-extras"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@guowenzhang/dsh-claude-compat": "^1.0.0",
    "@guowenzhang/dsh-mcp-manager": "^1.0.0",
    "@guowenzhang/dsh-memory": "^1.0.0",
    "@guowenzhang/dsh-ui-beautify": "^1.0.0",
    "@guowenzhang/dsh-web-design": "^1.0.0",
    "@guowenzhang/dsh-worktree": "^1.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "js-yaml": "^4.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
